{
    "name": "fair-queue/core",
    "description": "Framework-agnostic fairness policies for Laravel queue admission",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "FairQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FairQueue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FairQueue\\FairQueueServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
